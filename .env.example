# Название сайта. По умолчанию MrModrinth.
NEXT_PUBLIC_SITE_NAME=MrModrinth

# Базовый домен (без завершающего слэша).
# Если оставить пустым — og:url и canonical не выводятся, sitemap.xml не генерируется.
NEXT_PUBLIC_SITE_ORIGIN=

# ID счётчика Яндекс.Метрики. Если пусто — счётчик не подключается.
NEXT_PUBLIC_METRIKA_ID=

# Ссылка на репозиторий проекта (страница «О программе»: ссылка на исходный код
# и кнопка «Файл LICENSE на GitHub»).
NEXT_PUBLIC_SITE_GITHUB_URL=https://github.com/byMr712/MrModrinth
